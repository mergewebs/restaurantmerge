{
    "id": "/admin/",
    "name": "KOYA Admin",
    "short_name": "KOYA Admin",
    "description": "KOYA administration dashboard.",
    "lang": "en",
    "start_url": "/admin/dashboard?source=pwa",
    "scope": "/admin/",
    "display": "standalone",
    "display_override": ["standalone"],
    "orientation": "any",
    "background_color": "#17110c",
    "theme_color": "#17110c",
    "icons": [
        {
            "src": "/icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-maskable-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/icons/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ]
}
